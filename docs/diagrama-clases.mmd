classDiagram
  class Persona {
    <<abstract>>
    #id: String
    #nombre: String
    +getTipo() String
    +toRow() List~String~
  }
  class Cliente {
    -puntosFidelidad: int
    +getNivel() NivelCliente
    +agregarCompra(valor) void
  }
  class NivelCliente {
    <<enum>>
    BRONCE
    PLATA
    ORO
    DIAMANTE
  }
  class Producto {
    <<abstract>>
    #id: String
    #nombre: String
    #categoria: Categoria
    #precioCompra: double
    #precioVenta: double
    #stock: int
    +calcularMargen() double
    +vender(cant) bool
    +calcularPrecioFinal() double
    +getDetalleEspecifico() String
  }
  class Tabulable {
    <<interface>>
    +toRow() List~String~
  }
  class Inventariable {
    <<interface>>
    +vender(cant) bool
    +reponer(cant) void
    +necesitaReposicion() bool
  }
  class PoliticaDescuento {
    <<interface>>
    +calcular(cliente,sub,unds) double
  }
  class DescuentoEstandar {
    +calcular(cliente,sub,unds) double
  }
  class Libro {
    -autor: String
    -editorial: String
    -isbn: String
  }
  class UtilEscolar {
    -marca: String
    -tipoUtil: String
  }
  class Revista {
    -edicion: String
    -periodicidad: String
  }
  class Categoria {
    <<enum>>
    LIBRO_FICCION
    LIBRO_INFANTIL
    LIBRO_ACADEMICO
    UTILES
    ARTE
    REVISTA
  }
  class Venta {
    -id: String
    -fecha: DateTime
    +getTotalFinal() double
    +agregarDetalle(prod,cant) void
  }
  class DetalleVenta {
    -cantidad: int
    +getSubtotal() double
  }
  class Database {
    -productos: List~Producto~
    -clientes: List~Cliente~
    -ventas: List~Venta~
    +getInstancia() Database
  }
  class ProductoService {
    +buscar(query) List
    +stockBajo() List
  }
  class VentaService {
    +crearVenta(cliente,carrito) Venta
  }
  class RecomendacionService {
    +recomendar(base,max) List
  }
  class ReporteService {
    +ingresosTotales() double
    +dashboard() void
  }
  class ConsoleUI {
    +banner() void
    +tabla(headers,filas) void
  }
  class AppMenu {
    +iniciar() void
  }

  Persona <|-- Cliente
  Producto <|-- Libro
  Producto <|-- UtilEscolar
  Producto <|-- Revista
  Tabulable <|.. Persona
  Tabulable <|.. Producto
  Tabulable <|.. Venta
  Tabulable <|.. DetalleVenta
  Inventariable <|.. Producto
  PoliticaDescuento <|.. DescuentoEstandar
  Venta *-- DetalleVenta
  Venta o-- Cliente
  DetalleVenta o-- Producto
  Database o-- Producto
  Database o-- Cliente
  Database o-- Venta
